            "max": 5000,
            "step": 50,
            "unit": "ms"
          },
          {
            "name": "tabDuration",
            "type": "number",
            "label": "Tab open/close duration",
            "description": "Opening/closing speed for the instructions tab in milliseconds.",
            "default": 600,
            "min": 0,
            "max": 5000,
            "step": 50,
            "unit": "ms"
          },
          {
            "name": "tabClosedOffset",
            "type": "number",
            "label": "Tab closed extra offset",
            "description": "Extra offset (in px) applied when the tab is closed. 0 keeps it flush; higher values hide it more.",
